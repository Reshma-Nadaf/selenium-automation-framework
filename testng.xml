<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
    "https://testng.org/testng-1.0.dtd">

    <suite name = "Automation suite" parallel= "classes" thread-count="4">
    <groups>
    <run>
    	<include name="${groups}" />
    </run>
    </groups>
    <test name = "LoginTests">
    <classes>
     <class name="com.selenium.tests.GoggleTest"/>
    <class name="com.selenium.tests.LoginTest"/>
     <class name="com.selenium.tests.HomePageTest"/>
      <class name="com.selenium.tests.SearchTest"/>   
    </classes>
    </test>
    </suite>