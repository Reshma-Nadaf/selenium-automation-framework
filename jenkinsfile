pipeline {
    agent any
    
    parameters {
        choice(
            name: 'TEST_GROUP',
            choices: ['smoke', 'regression'],
            description: 'Select the TestNG group to execute'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                bat 'mvn clean test -Dgroups=%TEST_GROUP%'
            }
        }
        
        post{
			always{
				junit 'target/surefire-reports/*.xml'
			}
		}
    }
}